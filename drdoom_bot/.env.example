# Copy to drdoom_bot/.env and fill in. .env is gitignored.

# From @BotFather -> /newbot. Must be a NEW bot, not the trading commander's token.
DRDOOM_BOT_TOKEN=

# The GROUP the bot runs (not a broadcast channel). Either its public @username, or leave
# empty on first run, send /id in the group, and paste the number here.
DRDOOM_CHAT_ID=

# Optional overrides (defaults shown)
# DRDOOM_CA=HoTY1CsQCCUvhmjx3ikMVCMrYTsBfENQxzKmC7ebpump
# DRDOOM_SITE=https://drdoom.pages.dev/
# ALLOWED_DOMAINS=x.com,twitter.com
# GATE_TIMEOUT_MIN=5
# BUY_ALERTS=1
# MIN_BUY_SOL=0.1
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
