# --- secrets: NEVER commit ---
.env
*.pem
*.key

# --- python ---
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# --- runtime state & logs (machine-local, regenerated) ---
logs/
journal/
*.log
*.jsonl
*.lock
.offset
state.json
*_state.json
status.json
.gateway_alert_sent
.dirty_warned
nohup.out

