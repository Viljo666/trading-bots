data/
*.csv
*.parquet

# --- research output (large, regenerated by the matching *_research.py) ---
*_results.json

# --- separate repos (stock_screener has its own git + GH Actions deploy) ---
stock_screener/

# --- os / editor ---
.DS_Store
.idea/
.vscode/
.claude/

# --- drdoom community bot state ---
*.db
