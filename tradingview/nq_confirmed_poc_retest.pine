//@version=6
indicator("NQ Confirmed POC Retest [Research]", "NQ POC Retest", overlay = true,
     max_labels_count = 300, max_boxes_count = 200)

// NQ/MNQ research companion.  This is deliberately separate from the original
// ES/YM POC continuation indicator.  A setup must first close through the
// prior-RTH POC, then trade back to that POC on a later five-minute candle.
// Research indicator only: it draws and measures setups but never places orders.

// ─────────────────────────────────────────────────────────────────────────────
// Inputs
// ─────────────────────────────────────────────────────────────────────────────

string GROUP_SETUP = "NQ confirmed-retest setup"
string GROUP_PROFILE = "Prior RTH volume profile"
string GROUP_MANUAL = "Today's discretionary exit"
string GROUP_DISPLAY = "Display and alerts"
string NY_TZ = "America/New_York"

float atrMultiplier = input.float(0.25, "Stop = RTH ATR ×", minval = 0.05, step = 0.05, group = GROUP_SETUP)
float rewardRisk = input.float(3.0, "Target reward/risk", minval = 0.5, step = 0.5, group = GROUP_SETUP)
int atrPeriod = input.int(14, "RTH ATR sessions", minval = 2, maxval = 100, group = GROUP_SETUP)
string rthSession = input.session("0930-1600", "New York RTH", group = GROUP_SETUP)

float manualPocBin = input.float(0.0, "POC row size in points (0 = 4)", minval = 0.0, step = 0.25,
     group = GROUP_PROFILE, tooltip = "The tested NQ/MNQ row size is 4 points.")

bool enableManualExit = input.bool(false, "Enable today's discretionary exit", group = GROUP_MANUAL,
     tooltip = "Applies only to today's ET session. It does not change older historical trades.")
float manualExitPrice = input.price(0.0, "Drag exit level", group = GROUP_MANUAL,
     tooltip = "Drag this marker to a favorable chart level. Long exits require a level above entry; short exits require one below entry.")

bool showPositionBoxes = input.bool(true, "Show automatic risk/reward boxes", group = GROUP_DISPLAY)
bool showTradeLabels = input.bool(true, "Show setup and exit labels", group = GROUP_DISPLAY)
bool showDashboard = input.bool(true, "Show compact dashboard", group = GROUP_DISPLAY)
bool shadeRth = input.bool(true, "Highlight New York RTH", group = GROUP_DISPLAY)
bool enableDynamicAlerts = input.bool(false, "Send dynamic alert() messages", group = GROUP_DISPLAY,
     tooltip = "After enabling, create an alert using 'Any alert() function call'.")

bool isNasdaq = syminfo.root == "NQ" or syminfo.root == "MNQ"
bool supportedChart = timeframe.isminutes and timeframe.multiplier == 5
bool supportedSetup = isNasdaq and supportedChart
float pocStep = manualPocBin > 0 ? manualPocBin : 4.0
bool isTodayEt = year(time, NY_TZ) == year(timenow, NY_TZ) and
     month(time, NY_TZ) == month(timenow, NY_TZ) and dayofmonth(time, NY_TZ) == dayofmonth(timenow, NY_TZ)

// ─────────────────────────────────────────────────────────────────────────────
// Prior completed RTH POC and true RTH ATR
// ─────────────────────────────────────────────────────────────────────────────

profilePoc(float basePrice, float rowSize, array<float> rows) =>
    float result = na
    if array.size(rows) > 0
        float largest = array.max(rows)
        int largestIndex = array.indexof(rows, largest)
        result := basePrice + (largestIndex + 0.5) * rowSize
    result

bool inRth = not na(time(timeframe.period, rthSession, NY_TZ))
bool newRth = inRth and not inRth[1]
bool endRth = not inRth and inRth[1]
bool armClose = hour(time_close, NY_TZ) == 9 and minute(time_close, NY_TZ) == 35
bool cutoffClose = hour(time_close, NY_TZ) == 15 and minute(time_close, NY_TZ) == 0
bool flattenClose = hour(time_close, NY_TZ) == 15 and minute(time_close, NY_TZ) == 55

var array<float> rthProfile = array.new<float>(0)
var array<float> rthTrueRanges = array.new<float>(0)
var float profileBase = na
var float currentRthHigh = na
var float currentRthLow = na
var float currentRthClose = na
var float previousRthClose = na
var float priorRthPoc = na
var float priorRthAtr = na

if newRth
    array.clear(rthProfile)
    profileBase := math.floor(low / pocStep) * pocStep
    currentRthHigh := high
    currentRthLow := low
    currentRthClose := close

if inRth
    if na(profileBase)
        profileBase := math.floor(low / pocStep) * pocStep
    currentRthHigh := na(currentRthHigh) ? high : math.max(currentRthHigh, high)
    currentRthLow := na(currentRthLow) ? low : math.min(currentRthLow, low)
    currentRthClose := close

    float firstPriceRow = math.floor(low / pocStep) * pocStep
    float lastPriceRow = math.floor(high / pocStep) * pocStep
    if firstPriceRow < profileBase
        int prependCount = int(math.round((profileBase - firstPriceRow) / pocStep))
        if prependCount > 0
            for row = 0 to prependCount - 1
                array.unshift(rthProfile, 0.0)
        profileBase := firstPriceRow

    int firstIndex = int(math.floor((firstPriceRow - profileBase) / pocStep + 0.000001))
    int lastIndex = int(math.floor((lastPriceRow - profileBase) / pocStep + 0.000001))
    while array.size(rthProfile) <= lastIndex
        array.push(rthProfile, 0.0)
    int touchedRows = math.max(1, lastIndex - firstIndex + 1)
    float volumePerRow = nz(volume) / touchedRows
    if lastIndex >= firstIndex
        for row = firstIndex to lastIndex
            array.set(rthProfile, row, array.get(rthProfile, row) + volumePerRow)

if endRth and array.size(rthProfile) > 0
    priorRthPoc := profilePoc(profileBase, pocStep, rthProfile)
    float sessionRange = currentRthHigh - currentRthLow
    float highGap = na(previousRthClose) ? sessionRange : math.abs(currentRthHigh - previousRthClose)
    float lowGap = na(previousRthClose) ? sessionRange : math.abs(currentRthLow - previousRthClose)
    float trueRange = math.max(sessionRange, math.max(highGap, lowGap))
    array.push(rthTrueRanges, trueRange)
    if array.size(rthTrueRanges) > atrPeriod
        array.shift(rthTrueRanges)
    if array.size(rthTrueRanges) == atrPeriod
        priorRthAtr := array.avg(rthTrueRanges)
    previousRthClose := currentRthClose

// ─────────────────────────────────────────────────────────────────────────────
// Confirmed close, later POC retest, and position tracking
// ─────────────────────────────────────────────────────────────────────────────

// planState: 0 waiting, 1 waiting for close-through, 2 waiting for retest,
// 3 position open, 4 completed/cancelled.
var int planState = 0
var int planDirection = 0
var int planArmedBar = na
var int confirmationBar = na
var int entryBar = na
var float dayOpen = na
var float planEntry = na
var float planStop = na
var float planTarget = na
var float planRisk = na
var float confirmationClose = na
var box activeRiskBox = na
var box activeRewardBox = na

var int completedWins = 0
var int completedLosses = 0
var int completedBreakevens = 0
var float totalR = 0.0
var float grossWinningR = 0.0
var float grossLosingR = 0.0
var int statsStartedAt = na

bool armedSignal = false
bool confirmationSignal = false
bool longEntrySignal = false
bool shortEntrySignal = false
bool cutoffSignal = false
bool stopExitSignal = false
bool targetExitSignal = false
bool sessionExitSignal = false
bool manualExitSignal = false

if newRth
    planState := 0
    planDirection := 0
    planArmedBar := na
    confirmationBar := na
    entryBar := na
    dayOpen := open
    planEntry := na
    planStop := na
    planTarget := na
    planRisk := na
    confirmationClose := na

// The opening candle must be complete before a plan exists.  Open below POC
// seeks a bullish close through POC; open above seeks a bearish close through.
if armClose and barstate.isconfirmed and planState == 0 and supportedSetup and not na(priorRthPoc) and
  not na(priorRthAtr) and priorRthPoc != dayOpen
    planDirection := priorRthPoc > dayOpen ? 1 : -1
    planEntry := priorRthPoc
    planRisk := atrMultiplier * priorRthAtr
    planStop := planDirection == 1 ? planEntry - planRisk : planEntry + planRisk
    planTarget := planDirection == 1 ? planEntry + rewardRisk * planRisk : planEntry - rewardRisk * planRisk
    planState := 1
    planArmedBar := bar_index
    armedSignal := true
    if showTradeLabels
        label.new(bar_index, planEntry,
             (planDirection == 1 ? "WAIT BULL CLOSE" : "WAIT BEAR CLOSE") +
             "\nPOC " + str.tostring(planEntry, format.mintick),
             style = label.style_label_left, color = color.rgb(200, 125, 20),
             textcolor = color.white, size = size.small)

// Confirmation must come from a later completed five-minute candle.
if planState == 1 and bar_index > planArmedBar and barstate.isconfirmed
    bool closedThrough = planDirection == 1 ? close > planEntry : close < planEntry
    if closedThrough
        planState := 2
        confirmationBar := bar_index
        confirmationClose := close
        confirmationSignal := true
        if showTradeLabels
            label.new(bar_index, close,
                 (planDirection == 1 ? "BULL CLOSE CONFIRMED" : "BEAR CLOSE CONFIRMED") +
                 "\nWAIT FOR POC RETEST",
                 style = planDirection == 1 ? label.style_label_up : label.style_label_down,
                 color = color.aqua, textcolor = color.black, size = size.small)

// A genuine retest trades down to POC after a bullish confirmation or up to
// POC after a bearish confirmation.  It cannot fill on the confirmation bar.
if planState == 2 and bar_index > confirmationBar
    bool retestedPoc = planDirection == 1 ? low <= planEntry : high >= planEntry
    if retestedPoc
        planState := 3
        entryBar := bar_index
        if na(statsStartedAt)
            statsStartedAt := time
        longEntrySignal := planDirection == 1
        shortEntrySignal := planDirection == -1
        if showPositionBoxes
            if planDirection == 1
                activeRiskBox := box.new(left = bar_index, top = planEntry, right = bar_index + 1, bottom = planStop,
                     xloc = xloc.bar_index, border_color = color.new(color.red, 5), border_width = 1,
                     bgcolor = color.new(color.red, 78), text = "1R RISK", text_color = color.white, text_size = size.tiny)
                activeRewardBox := box.new(left = bar_index, top = planTarget, right = bar_index + 1, bottom = planEntry,
                     xloc = xloc.bar_index, border_color = color.new(color.lime, 5), border_width = 1,
                     bgcolor = color.new(color.lime, 82), text = str.tostring(rewardRisk) + "R REWARD",
                     text_color = color.white, text_size = size.tiny)
            else
                activeRiskBox := box.new(left = bar_index, top = planStop, right = bar_index + 1, bottom = planEntry,
                     xloc = xloc.bar_index, border_color = color.new(color.red, 5), border_width = 1,
                     bgcolor = color.new(color.red, 78), text = "1R RISK", text_color = color.white, text_size = size.tiny)
                activeRewardBox := box.new(left = bar_index, top = planEntry, right = bar_index + 1, bottom = planTarget,
                     xloc = xloc.bar_index, border_color = color.new(color.lime, 5), border_width = 1,
                     bgcolor = color.new(color.lime, 82), text = str.tostring(rewardRisk) + "R REWARD",
                     text_color = color.white, text_size = size.tiny)
        if showTradeLabels
            label.new(bar_index, planEntry, planDirection == 1 ? "LONG RETEST FILLED" : "SHORT RETEST FILLED",
                 style = planDirection == 1 ? label.style_label_up : label.style_label_down,
                 color = planDirection == 1 ? color.lime : color.red,
                 textcolor = planDirection == 1 ? color.black : color.white, size = size.small)

// The 14:55–15:00 candle remains eligible.  Anything still waiting at its
// close is cancelled; no new confirmation or retest carries past 15:00 ET.
if (planState == 1 or planState == 2) and cutoffClose and barstate.isconfirmed
    planState := 4
    cutoffSignal := true
    if showTradeLabels
        label.new(bar_index, planEntry, "SETUP CANCELLED\n15:00 cutoff",
             style = label.style_label_left, color = color.new(color.gray, 15),
             textcolor = color.white, size = size.tiny)

if planState == 3 and showPositionBoxes
    if not na(activeRiskBox)
        box.set_right(activeRiskBox, bar_index + 1)
    if not na(activeRewardBox)
        box.set_right(activeRewardBox, bar_index + 1)

// Stop-first is conservative when a later five-minute candle reaches both
// stop and target.  The ambiguous entry candle itself is not used for exits.
if planState == 3 and bar_index > entryBar
    bool stopHit = planDirection == 1 ? low <= planStop : high >= planStop
    bool targetHit = planDirection == 1 ? high >= planTarget : low <= planTarget
    bool manualLevelValid = enableManualExit and isTodayEt and manualExitPrice > 0 and
         (planDirection == 1 ? manualExitPrice > planEntry : manualExitPrice < planEntry)
    bool manualLevelHit = manualLevelValid and
         (planDirection == 1 ? high >= manualExitPrice : low <= manualExitPrice)
    float outcomeR = na
    if stopHit
        outcomeR := -1.0
        stopExitSignal := true
    else if manualLevelHit
        float manualPoints = planDirection == 1 ? manualExitPrice - planEntry : planEntry - manualExitPrice
        outcomeR := manualPoints / planRisk
        manualExitSignal := true
    else if targetHit
        outcomeR := rewardRisk
        targetExitSignal := true
    else if flattenClose and barstate.isconfirmed
        float points = planDirection == 1 ? close - planEntry : planEntry - close
        outcomeR := points / planRisk
        sessionExitSignal := true

    if not na(outcomeR)
        totalR += outcomeR
        if outcomeR > 0.001
            completedWins += 1
            grossWinningR += outcomeR
        else if outcomeR < -0.001
            completedLosses += 1
            grossLosingR += math.abs(outcomeR)
        else
            completedBreakevens += 1
        if showTradeLabels
            string exitText = stopExitSignal ? "STOP  −1R" : manualExitSignal ? "DISCRETIONARY EXIT  +" +
                 str.tostring(outcomeR, "#.##") + "R" : targetExitSignal ? "TARGET  +" +
                 str.tostring(rewardRisk) + "R" : "15:55 EXIT  " + str.tostring(outcomeR, "#.##") + "R"
            label.new(bar_index, close, exitText, style = label.style_label_left,
                 color = outcomeR > 0 ? color.green : outcomeR < 0 ? color.red : color.gray,
                 textcolor = color.white, size = size.small)
        planState := 4

// ─────────────────────────────────────────────────────────────────────────────
// Plots and alerts
// ─────────────────────────────────────────────────────────────────────────────

bgcolor(shadeRth and inRth ? color.new(color.blue, 94) : na, title = "New York RTH")
plot(priorRthPoc, "Prior RTH POC", color = color.yellow, linewidth = 2, style = plot.style_stepline)
plot(planState == 1 or planState == 2 ? planEntry : na, "Confirmation/retest level",
     color = planState == 2 ? color.aqua : color.orange, linewidth = 3, style = plot.style_linebr)
plot(planState == 3 ? planEntry : na, "Filled entry", color = color.white, linewidth = 1, style = plot.style_linebr)
plot(planState >= 1 and planState <= 3 ? planStop : na, "Stop", color = color.red, linewidth = 2, style = plot.style_linebr)
plot(planState >= 1 and planState <= 3 ? planTarget : na, "3R target", color = color.lime, linewidth = 2, style = plot.style_linebr)
plot(inRth ? dayOpen : na, "RTH open", color = color.new(color.aqua, 35), style = plot.style_linebr)
plot(enableManualExit and isTodayEt and manualExitPrice > 0 ? manualExitPrice : na,
     "Today's discretionary exit", color = color.fuchsia, linewidth = 3, style = plot.style_linebr)

plotshape(confirmationSignal, title = "POC close confirmed", style = shape.diamond, location = location.abovebar,
     color = color.aqua, size = size.small, text = "CLOSE")
plotshape(longEntrySignal, title = "Long POC retest", style = shape.triangleup, location = location.belowbar,
     color = color.lime, size = size.small, text = "RETEST L")
plotshape(shortEntrySignal, title = "Short POC retest", style = shape.triangledown, location = location.abovebar,
     color = color.red, size = size.small, text = "RETEST S")

alertcondition(armedSignal, "NQ POC setup armed", "NQ POC Retest: waiting for a candle close through prior POC.")
alertcondition(confirmationSignal, "NQ POC close confirmed",
     'NQ POC CONFIRMED | Wait for retest of {{plot("Confirmation/retest level")}}')
alertcondition(longEntrySignal, "NQ long retest filled",
     'NQ LONG RETEST | Entry {{plot("Filled entry")}} | SL {{plot("Stop")}} | TP {{plot("3R target")}}')
alertcondition(shortEntrySignal, "NQ short retest filled",
     'NQ SHORT RETEST | Entry {{plot("Filled entry")}} | SL {{plot("Stop")}} | TP {{plot("3R target")}}')
alertcondition(cutoffSignal, "NQ POC setup cancelled", "NQ POC Retest: setup cancelled at 15:00 New York.")
alertcondition(stopExitSignal, "NQ POC stop hit", "NQ POC Retest: stop hit.")
alertcondition(targetExitSignal, "NQ POC target hit", "NQ POC Retest: 3R target hit.")
alertcondition(sessionExitSignal, "NQ POC session exit", "NQ POC Retest: exited at 15:55 New York.")
alertcondition(manualExitSignal, "NQ discretionary level hit", "NQ POC Retest: today's discretionary exit level was hit.")

if enableDynamicAlerts and armedSignal
    alert("NQ POC ARMED | wait for close through " + str.tostring(planEntry, format.mintick),
         alert.freq_once_per_bar_close)
if enableDynamicAlerts and confirmationSignal
    alert("NQ POC CONFIRMED | wait for retest of " + str.tostring(planEntry, format.mintick),
         alert.freq_once_per_bar_close)
if enableDynamicAlerts and longEntrySignal
    alert("NQ POC LONG RETEST FILLED @ " + str.tostring(planEntry, format.mintick) +
         " | SL " + str.tostring(planStop, format.mintick) + " | TP " + str.tostring(planTarget, format.mintick),
         alert.freq_once_per_bar)
if enableDynamicAlerts and shortEntrySignal
    alert("NQ POC SHORT RETEST FILLED @ " + str.tostring(planEntry, format.mintick) +
         " | SL " + str.tostring(planStop, format.mintick) + " | TP " + str.tostring(planTarget, format.mintick),
         alert.freq_once_per_bar)
if enableDynamicAlerts and manualExitSignal
    alert("NQ DISCRETIONARY EXIT HIT @ " + str.tostring(manualExitPrice, format.mintick),
         alert.freq_once_per_bar)

// ─────────────────────────────────────────────────────────────────────────────
// Compact mobile-friendly dashboard
// ─────────────────────────────────────────────────────────────────────────────

var table dashboard = table.new(position.top_right, 2, 17,
     bgcolor = color.new(color.black, 0), frame_color = color.white, frame_width = 2,
     border_color = color.new(color.gray, 20), border_width = 1)

if barstate.islast and showDashboard
    color header = color.rgb(94, 50, 150)
    color labelCell = color.rgb(25, 25, 30)
    color bullCell = color.rgb(22, 135, 70)
    color bearCell = color.rgb(185, 45, 45)
    color waitCell = color.rgb(200, 125, 20)
    color neutralCell = color.rgb(65, 65, 72)
    string stateText = planState == 1 ? "WAIT CLOSE" : planState == 2 ? "WAIT RETEST" : planState == 3 ?
      (planDirection == 1 ? "LONG OPEN" : "SHORT OPEN") : planState == 4 ? "DONE" : "WAIT 09:35"
    color stateColor = planState == 3 ? (planDirection == 1 ? bullCell : bearCell) :
      planState == 2 ? color.rgb(20, 145, 165) : planState == 1 ? waitCell : neutralCell
    int decidedTrades = completedWins + completedLosses
    float winRate = decidedTrades > 0 ? 100.0 * completedWins / decidedTrades : na
    float profitFactor = grossLosingR > 0 ? grossWinningR / grossLosingR : na
    string resultText = str.tostring(completedWins) + " W / " + str.tostring(completedLosses) + " L"
    if completedBreakevens > 0
        resultText += " / " + str.tostring(completedBreakevens) + " BE"
    string statsDate = na(statsStartedAt) ? "No fills yet" : str.format_time(statsStartedAt, "yyyy-MM-dd", NY_TZ)

    table.cell(dashboard, 0, 0, "NQ CONFIRMED POC", text_color = color.white, bgcolor = header, text_size = size.large)
    table.cell(dashboard, 1, 0, supportedChart ? syminfo.root + "  5m" : "USE 5m",
         text_color = color.white, bgcolor = supportedSetup ? header : color.red, text_size = size.large)
    table.cell(dashboard, 0, 1, "Market status", text_color = color.white, bgcolor = labelCell, text_size = size.normal)
    table.cell(dashboard, 1, 1, supportedSetup ? "NQ RESEARCH ONLY" : isNasdaq ? "USE 5-MINUTE" : "USE NQ / MNQ",
         text_color = color.white, bgcolor = supportedSetup ? waitCell : bearCell, text_size = size.normal)
    table.cell(dashboard, 0, 2, "Setup", text_color = color.white, bgcolor = labelCell, text_size = size.normal)
    table.cell(dashboard, 1, 2, "CLOSE → LATER RETEST", text_color = color.black,
         bgcolor = color.aqua, text_size = size.normal)
    table.cell(dashboard, 0, 3, "Status", text_color = color.white, bgcolor = labelCell, text_size = size.normal)
    table.cell(dashboard, 1, 3, stateText, text_color = color.white, bgcolor = stateColor, text_size = size.normal)
    table.cell(dashboard, 0, 4, "Prior POC", text_color = color.white, bgcolor = labelCell, text_size = size.normal)
    table.cell(dashboard, 1, 4, na(priorRthPoc) ? "Collecting…" : str.tostring(priorRthPoc, format.mintick),
         text_color = color.black, bgcolor = color.rgb(245, 205, 35), text_size = size.normal)
    table.cell(dashboard, 0, 5, "RTH ATR(" + str.tostring(atrPeriod) + ")",
         text_color = color.white, bgcolor = labelCell, text_size = size.normal)
    table.cell(dashboard, 1, 5, na(priorRthAtr) ? "Collecting…" : str.tostring(priorRthAtr, "#.##"),
         text_color = color.white, bgcolor = neutralCell, text_size = size.normal)
    table.cell(dashboard, 0, 6, "Today open", text_color = color.white, bgcolor = labelCell, text_size = size.normal)
    table.cell(dashboard, 1, 6, na(dayOpen) ? "—" : str.tostring(dayOpen, format.mintick),
         text_color = color.white, bgcolor = neutralCell, text_size = size.normal)
    table.cell(dashboard, 0, 7, "Direction", text_color = color.white, bgcolor = labelCell, text_size = size.normal)
    table.cell(dashboard, 1, 7, planDirection == 1 ? "LONG" : planDirection == -1 ? "SHORT" : "—",
         text_color = color.white, bgcolor = planDirection == 1 ? bullCell : planDirection == -1 ? bearCell : neutralCell,
         text_size = size.normal)
    table.cell(dashboard, 0, 8, "Confirmation", text_color = color.white, bgcolor = labelCell, text_size = size.normal)
    table.cell(dashboard, 1, 8, na(confirmationClose) ? "WAITING" : str.tostring(confirmationClose, format.mintick),
         text_color = na(confirmationClose) ? color.white : color.black,
         bgcolor = na(confirmationClose) ? waitCell : color.aqua, text_size = size.normal)
    table.cell(dashboard, 0, 9, "Retest entry", text_color = color.white, bgcolor = labelCell, text_size = size.normal)
    table.cell(dashboard, 1, 9, na(planEntry) ? "—" : str.tostring(planEntry, format.mintick),
         text_color = na(planEntry) ? color.white : color.black,
         bgcolor = na(planEntry) ? neutralCell : color.orange, text_size = size.normal)
    table.cell(dashboard, 0, 10, "Stop", text_color = color.white, bgcolor = labelCell, text_size = size.normal)
    table.cell(dashboard, 1, 10, na(planStop) ? "—" : str.tostring(planStop, format.mintick),
         text_color = color.white, bgcolor = na(planStop) ? neutralCell : bearCell, text_size = size.normal)
    table.cell(dashboard, 0, 11, "Target", text_color = color.white, bgcolor = labelCell, text_size = size.normal)
    table.cell(dashboard, 1, 11, na(planTarget) ? "—" : str.tostring(planTarget, format.mintick) + "  (" +
         str.tostring(rewardRisk) + "R)", text_color = na(planTarget) ? color.white : color.black,
         bgcolor = na(planTarget) ? neutralCell : color.rgb(55, 205, 105), text_size = size.normal)
    bool dashboardManualValid = enableManualExit and manualExitPrice > 0 and not na(planEntry) and
         (planDirection == 1 ? manualExitPrice > planEntry : planDirection == -1 ? manualExitPrice < planEntry : false)
    string manualText = not enableManualExit ? "OFF" : not dashboardManualValid ? "SET FAVORABLE PRICE" :
         str.tostring(manualExitPrice, format.mintick)
    table.cell(dashboard, 0, 12, "Today's exit", text_color = color.white, bgcolor = labelCell, text_size = size.normal)
    table.cell(dashboard, 1, 12, manualText, text_color = color.white,
         bgcolor = dashboardManualValid ? color.fuchsia : enableManualExit ? waitCell : neutralCell, text_size = size.normal)
    table.cell(dashboard, 0, 13, "Results", text_color = color.white, bgcolor = labelCell, text_size = size.normal)
    table.cell(dashboard, 1, 13, resultText, text_color = color.white,
         bgcolor = completedWins > completedLosses ? bullCell : completedWins < completedLosses ? bearCell : neutralCell,
         text_size = size.normal)
    table.cell(dashboard, 0, 14, "Win rate", text_color = color.white, bgcolor = labelCell, text_size = size.normal)
    table.cell(dashboard, 1, 14, na(winRate) ? "—" : str.tostring(winRate, "#.0") + "%",
         text_color = color.white, bgcolor = na(winRate) ? neutralCell : winRate >= 40 ? bullCell : bearCell,
         text_size = size.large)
    table.cell(dashboard, 0, 15, "Gross R / PF", text_color = color.white, bgcolor = labelCell, text_size = size.normal)
    table.cell(dashboard, 1, 15, str.tostring(totalR, "#.##") + "R  /  " +
         (na(profitFactor) ? "—" : str.tostring(profitFactor, "#.##")),
         text_color = color.white, bgcolor = totalR > 0 ? bullCell : totalR < 0 ? bearCell : neutralCell,
         text_size = size.normal)
    table.cell(dashboard, 0, 16, "Stats from", text_color = color.white, bgcolor = labelCell, text_size = size.normal)
    table.cell(dashboard, 1, 16, statsDate, text_color = color.white, bgcolor = neutralCell, text_size = size.normal)
    for dashboardRow = 0 to 16
        for dashboardColumn = 0 to 1
            table.cell_set_text_size(dashboard, dashboardColumn, dashboardRow, size.tiny)
